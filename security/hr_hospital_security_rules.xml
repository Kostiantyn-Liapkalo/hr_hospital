        <record id="rule_hr_hospital_diagnosis_admin_full" model="ir.rule">
            <field name="name">Administrator: Full Access to Diagnoses</field>
            <field name="model_id" ref="model_hr_hospital_diagnosis"/>
            <field name="groups" eval="[(4, ref('group_hr_hospital_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_hr_hospital_disease_admin_full" model="ir.rule">
            <field name="name">Administrator: Full Access to Diseases</field>
            <field name="model_id" ref="model_hr_hospital_disease"/>
            <field name="groups" eval="[(4, ref('group_hr_hospital_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_hr_hospital_doctor_schedule_admin_full" model="ir.rule">
            <field name="name">Administrator: Full Access to Doctor Schedules</field>
            <field name="model_id" ref="model_hr_hospital_doctor_schedule"/>
            <field name="groups" eval="[(4, ref('group_hr_hospital_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_hr_hospital_contact_person_admin_full" model="ir.rule">
            <field name="name">Administrator: Full Access to Contact Persons</field>
            <field name="model_id" ref="model_hr_hospital_contact_person"/>
            <field name="groups" eval="[(4, ref('group_hr_hospital_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
