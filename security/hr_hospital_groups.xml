<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Hospital User Groups -->
        <record id="group_hr_hospital_patient" model="res.groups">
            <field name="name">Patient</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="comment">Hospital patients can view their own medical records and schedule visits.</field>
        </record>

        <record id="group_hr_hospital_intern" model="res.groups">
            <field name="name">Intern</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_patient'))]"/>
            <field name="comment">Hospital interns can view patient records and create visits under supervision.</field>
        </record>

        <record id="group_hr_hospital_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_intern'))]"/>
            <field name="comment">Hospital doctors can manage patient records, visits, diagnoses, and schedules.</field>
        </record>

        <record id="group_hr_hospital_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_doctor'))]"/>
            <field name="comment">Hospital managers can manage doctors, departments, and view reports.</field>
        </record>

        <record id="group_hr_hospital_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_manager'))]"/>
            <field name="comment">Hospital administrators have full access to all hospital management features.</field>
        </record>
    </data>
</odoo>
