<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Diagnosis Demo Data -->
        <record id="diagnosis_flu" model="hr.hospital.diagnosis">
            <field name="name">DIAG001</field>
            <field name="visit_id" ref="demo_visit_1"/>
            <field name="disease_id" ref="disease_influenza"/>
            <field name="description">Patient presents with typical influenza symptoms including fever, cough, and body aches.</field>
            <field name="prescribed_treatment"><![CDATA[
                <p>Prescribed treatment:</p>
                <ul>
                    <li>Rest and hydration</li>
                    <li>Antipyretics for fever</li>
                    <li>Symptomatic relief</li>
                </ul>
            ]]></field>
            <field name="severity">moderate</field>
            <field name="diagnosis_date" eval="DateTime.now() - timedelta(days=5)"/>
            <field name="is_approved">True</field>
        </record>
        
        <record id="diagnosis_hypertension" model="hr.hospital.diagnosis">
            <field name="name">DIAG002</field>
            <field name="visit_id" ref="demo_visit_2"/>
            <field name="disease_id" ref="disease_hypertension"/>
            <field name="description">Patient diagnosed with essential hypertension, stage 1.</field>
            <field name="prescribed_treatment"><![CDATA[
                <p>Treatment plan:</p>
                <ul>
                    <li>ACE inhibitors</li>
                    <li>Dietary modifications</li>
                    <li>Regular exercise</li>
                    <li>Monthly follow-up</li>
                </ul>
            ]]></field>
            <field name="severity">moderate</field>
            <field name="diagnosis_date" eval="DateTime.now() - timedelta(days=10)"/>
            <field name="is_approved">True</field>
        </record>
        
        <record id="diagnosis_fracture" model="hr.hospital.diagnosis">
            <field name="name">DIAG003</field>
            <field name="visit_id" ref="demo_visit_3"/>
            <field name="disease_id" ref="disease_fracture"/>
            <field name="description">Patient with closed fracture of the right radius.</field>
            <field name="prescribed_treatment"><![CDATA[
                <p>Emergency treatment:</p>
                <ul>
                    <li>Closed reduction</li>
                    <li>Cast immobilization</li>
                    <li>Pain management</li>
                    <li>Orthopedic follow-up in 1 week</li>
                </ul>
            ]]></field>
            <field name="severity">severe</field>
            <field name="diagnosis_date" eval="DateTime.now() - timedelta(days=2)"/>
            <field name="is_approved">True</field>
        </record>
        
        <record id="diagnosis_allergy" model="hr.hospital.diagnosis">
            <field name="name">DIAG004</field>
            <field name="visit_id" ref="demo_visit_4"/>
            <field name="disease_id" ref="disease_allergy"/>
            <field name="description">Patient presents with allergic rhinitis, likely due to pollen allergy.</field>
            <field name="prescribed_treatment"><![CDATA[
                <p>Allergy management:</p>
                <ul>
                    <li>Antihistamines</li>
                    <li>Nasal corticosteroids</li>
                    <li>Allergen avoidance</li>
                    <li>Allergy testing recommended</li>
                </ul>
            ]]></field>
            <field name="severity">mild</field>
            <field name="diagnosis_date" eval="DateTime.now() - timedelta(days=7)"/>
            <field name="is_approved">True</field>
        </record>
        
        <!-- Unapproved diagnosis from intern -->
        <record id="diagnosis_intern_unapproved" model="hr.hospital.diagnosis">
            <field name="name">DIAG005</field>
            <field name="visit_id" ref="demo_visit_5"/>
            <field name="disease_id" ref="disease_gastritis"/>
            <field name="description">Patient with symptoms of acute gastritis.</field>
            <field name="prescribed_treatment"><![CDATA[
                <p>Initial treatment:</p>
                <ul>
                    <li>Proton pump inhibitors</li>
                    <li>Dietary modifications</li>
                    <li>Avoid irritants</li>
                </ul>
            ]]></field>
            <field name="severity">mild</field>
            <field name="diagnosis_date" eval="DateTime.now() - timedelta(days=1)"/>
            <field name="is_approved">False</field>
        </record>
        
        <!-- Additional Demo Diagnoses -->
        <record id="diagnosis_asthma" model="hr.hospital.diagnosis">
            <field name="name">DIAG006</field>
            <field name="visit_id" ref="visit_planned_2"/>
            <field name="disease_id" ref="disease_asthma"/>
            <field name="description">Patient with persistent asthma symptoms, requires inhaler therapy.</field>
            <field name="prescribed_treatment"><![CDATA[
                <p>Asthma management:</p>
                <ul>
                    <li>Inhaled corticosteroids</li>
                    <li>Bronchodilators as needed</li>
                    <li>Spirometry monitoring</li>
                    <li>Avoid triggers</li>
                </ul>
            ]]></field>
            <field name="severity">moderate</field>
            <field name="diagnosis_date" eval="DateTime.now() - timedelta(days=15)"/>
            <field name="is_approved">True</field>
        </record>
        
        <record id="diagnosis_diabetes_type2" model="hr.hospital.diagnosis">
            <field name="name">DIAG007</field>
            <field name="visit_id" ref="visit_planned_3"/>
            <field name="disease_id" ref="disease_diabetes_type2"/>
            <field name="description">Type 2 diabetes mellitus with good glycemic control.</field>
            <field name="prescribed_treatment"><![CDATA[
                <p>Diabetes management:</p>
                <ul>
                    <li>Metformin 500mg twice daily</li>
                    <li>Glucose monitoring</li>
                    <li>Diabetic diet</li>
                    <li>Quarterly HbA1c tests</li>
                </ul>
            ]]></field>
            <field name="severity">moderate</field>
            <field name="diagnosis_date" eval="DateTime.now() - timedelta(days=20)"/>
            <field name="is_approved">True</field>
        </record>
        
        <record id="diagnosis_migraine" model="hr.hospital.diagnosis">
            <field name="name">DIAG008</field>
            <field name="visit_id" ref="visit_completed_2"/>
            <field name="disease_id" ref="disease_migraine"/>
            <field name="description">Chronic migraine with aura, frequent episodes affecting daily activities.</field>
            <field name="prescribed_treatment"><![CDATA[
                <p>Migraine treatment:</p>
                <ul>
                    <li>Triptans for acute attacks</li>
                    <li>Beta blockers for prevention</li>
                    <li>Stress management</li>
                    <li>Sleep hygiene</li>
                </ul>
            ]]></field>
            <field name="severity">moderate</field>
            <field name="diagnosis_date" eval="DateTime.now() - timedelta(days=8)"/>
            <field name="is_approved">True</field>
        </record>
        
        <record id="diagnosis_pneumonia" model="hr.hospital.diagnosis">
            <field name="name">DIAG009</field>
            <field name="visit_id" ref="visit_in_progress_1"/>
            <field name="disease_id" ref="disease_pneumonia"/>
            <field name="description">Community-acquired pneumonia with consolidation on chest X-ray.</field>
            <field name="prescribed_treatment"><![CDATA[
                <p>Pneumonia treatment:</p>
                <ul>
                    <li>Antibiotics (Amoxicillin)</li>
                    <li>Respiratory therapy</li>
                    <li>Oxygen support if needed</li>
                    <li>Rest and hydration</li>
                </ul>
            ]]></field>
            <field name="severity">severe</field>
            <field name="diagnosis_date" eval="DateTime.now() - timedelta(days=2)"/>
            <field name="is_approved">True</field>
        </record>
        
        <record id="diagnosis_allergic_rhinitis" model="hr.hospital.diagnosis">
            <field name="name">DIAG010</field>
            <field name="visit_id" ref="visit_completed_3"/>
            <field name="disease_id" ref="disease_allergic_rhinitis"/>
            <field name="description">Seasonal allergic rhinitis with nasal congestion and sneezing.</field>
            <field name="prescribed_treatment"><![CDATA[
                <p>Allergy management:</p>
                <ul>
                    <li>Antihistamines</li>
                    <li>Nasal corticosteroid spray</li>
                    <li>Avoid allergens</li>
                    <li>Air purifier recommended</li>
                </ul>
            ]]></field>
            <field name="severity">mild</field>
            <field name="diagnosis_date" eval="DateTime.now() - timedelta(days=12)"/>
            <field name="is_approved">True</field>
        </record>
        
        <record id="diagnosis_anemia" model="hr.hospital.diagnosis">
            <field name="name">DIAG011</field>
            <field name="visit_id" ref="visit_no_show_1"/>
            <field name="disease_id" ref="disease_anemia"/>
            <field name="description">Iron deficiency anemia with fatigue and pallor symptoms.</field>
            <field name="prescribed_treatment"><![CDATA[
                <p>Anemia treatment:</p>
                <ul>
                    <li>Iron supplements</li>
                    <li>Vitamin C for absorption</li>
                    <li>Iron-rich diet</li>
                    <li>Follow-up blood tests</li>
                </ul>
            ]]></field>
            <field name="severity">moderate</field>
            <field name="diagnosis_date" eval="DateTime.now() - timedelta(days=6)"/>
            <field name="is_approved">True</field>
        </record>
    </data>
</odoo>